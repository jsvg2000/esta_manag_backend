// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique

  users User[]
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  roleId   Int
  role     Role    @relation(fields: [roleId], references: [id])

  updatedMerchants      Merchant[]      @relation("MerchantUpdatedBy")
  updatedEstablishments Establishment[] @relation("EstablishmentUpdatedBy")
}

model MerchantState {
  id   Int    @id @default(autoincrement())
  name String @unique

  merchants Merchant[]
}

model Merchant {
  id               Int       @id @default(autoincrement())
  businessName     String
  municipality     String
  phone            String?
  email            String?
  registrationDate DateTime  @default(now())
  stateId          Int
  state            MerchantState @relation(fields: [stateId], references: [id])
  lastUpdated      DateTime  @default(now())
  updatedByUserId  Int?
  updatedBy        User?     @relation("MerchantUpdatedBy", fields: [updatedByUserId], references: [id])

  establishments Establishment[]
}

model Establishment {
  id                 Int      @id @default(autoincrement())
  name               String
  revenue            Decimal  @db.Decimal(15, 2)
  numberOfEmployees  Int
  merchantId         Int
  merchant           Merchant @relation(fields: [merchantId], references: [id])
  lastUpdated        DateTime @default(now())
  updatedByUserId    Int?
  updatedBy          User?    @relation("EstablishmentUpdatedBy", fields: [updatedByUserId], references: [id])
}